{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traininghq",
  "main": "src/index.js",
  "compatibility_date": "2026-10-24",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "traininghq-db", "database_id": "PASTE_YOUR_DATABASE_ID_HERE" }
  ]
}
